#--------------------------------------------------------------------
# TravelPilot Environment Configuration
# Copy to .env and fill in your values.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# Base URL (no trailing slash)
# TravelPilot dev port is 8081 — 8080 is reserved for EaseMySale on this machine.
# Production: set to your domain, e.g. https://app.travelpilot.io
app.baseURL = 'http://localhost:8081'

#--------------------------------------------------------------------
# APP MODE — saas or self_hosted
#--------------------------------------------------------------------
APP_MODE = saas

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = travelpilot
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Test database (PHPUnit) — leave COMMENTED; CI4 uses SQLite3 :memory: by default.
# Uncomment only if you want PHPUnit to run against a real MySQL test DB.
# database.tests.hostname = localhost
# database.tests.database = travelpilot_test
# database.tests.username = root
# database.tests.password =
# database.tests.DBDriver = MySQLi
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION (php spark key:generate — do not commit the real key)
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.cookieName = 'tp_session'
session.expiration = 7200
session.savePath = 'ci_sessions'
session.matchIP = false

#--------------------------------------------------------------------
# QUEUE / JOBS (database driver — no Redis required locally)
#--------------------------------------------------------------------
QUEUE_DRIVER = database

#--------------------------------------------------------------------
# CORS (frontend origin for local dev)
#--------------------------------------------------------------------
CORS_ORIGIN = http://localhost:5917

#--------------------------------------------------------------------
# SELF-HOSTED LICENSING (only relevant when APP_MODE=self_hosted)
#--------------------------------------------------------------------
# LICENSE_VALIDATE_URL = https://license.gamavis.com/validate
# LICENSE_OFFLINE_GRACE_DAYS = 7

#--------------------------------------------------------------------
# RAZORPAY (only relevant when APP_MODE=saas — use test keys locally)
#--------------------------------------------------------------------
# RAZORPAY_KEY_ID =
# RAZORPAY_KEY_SECRET =
# RAZORPAY_WEBHOOK_SECRET =

#--------------------------------------------------------------------
# META / WHATSAPP (Sprint 2 — use sandbox creds locally)
#--------------------------------------------------------------------
# Meta App credentials (from Meta for Developers dashboard)
# Needed for two things: webhook signature verification, and the Social
# Planner's "Connect with Facebook" button. Set BOTH or the button stays
# hidden and pages can only be connected with a hand-pasted token.
# Add this exact URL to the Meta app under Facebook Login → Settings →
# Valid OAuth Redirect URIs (the Social page shows it for you):
#   <app.baseURL>/api/v1/social/oauth/callback
# META_APP_ID =
# META_APP_SECRET =          ← used for X-Hub-Signature-256 verification
# If the app uses Facebook Login FOR BUSINESS rather than classic
# Facebook Login, permissions come from a dashboard configuration and the
# scope list is rejected ("Invalid Scopes: …"). Put the configuration id
# here — Facebook Login for Business → Configurations in the app dashboard.
# META_LOGIN_CONFIG_ID =

# Graph API version — keep up to date with Meta's stable release
META_GRAPH_VERSION = v22.0

# Set to false ONLY for local dev when you can't provide a real signature
# (e.g. sending test payloads with curl). MUST be true in production.
# A loud boot warning is logged whenever this is false.
WEBHOOK_VERIFY_SIGNATURE = true

# Set to true to run the full send pipeline locally without hitting Meta.
# CloudApiClient returns simulated success responses (fake message IDs, templates
# immediately auto-approved). MUST be false in production.
# A loud alert warning is logged whenever this is true.
WHATSAPP_MOCK_MODE = false

#--------------------------------------------------------------------
# META LEAD ADS (Sprint 5)
#--------------------------------------------------------------------
# Set to true to bypass the Graph API lead fetch and use test data.
# Full pipeline (webhook→job→contact→trigger) runs locally without
# an approved Meta App. MUST be false in production.
META_LEADS_MOCK_MODE = false
# Test lead data used when META_LEADS_MOCK_MODE=true
# META_MOCK_LEAD_NAME  = Test Lead
# META_MOCK_LEAD_PHONE = +919999900001

# ── Email (SMTP) ─────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
# tls (587) or ssl (465). Defaults from port if unset. Gmail uses tls/587.
MAIL_CRYPTO=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@travelpilot.app
# Quote any value containing spaces, e.g. MAIL_FROM_NAME = "Gamavis TravelPilot"
MAIL_FROM_NAME=TravelPilot
# Set to 1 to disable actual email sending (log only)
MAIL_LOG_ONLY=0
# CRM contact email (Phase L): true skips the SMTP transport but still logs the
# email row + timeline activity — use for local dev / tests. Tenants can override
# the platform MAIL_* settings above with their own SMTP under Settings (per-tenant).
EMAIL_MOCK_MODE = false

# Email marketing — public base URL for open-pixel / click / unsubscribe links in
# campaign emails (must reach PHP: /webhooks/ and /forms/). Defaults to APP_URL,
# which is right in production; set it to the backend origin in local dev.
# EMAIL_TRACKING_URL = http://127.0.0.1:8091

# ── Security ──────────────────────────────────────────────
# API token lifetime in days (default 90)
TOKEN_EXPIRY_DAYS=90
# Frontend URL (used in password reset emails)
APP_URL=http://localhost:5917

# ── Campaign send throttle ────────────────────────────────
# Delay between per-contact sends in milliseconds (0 = no delay, for Tier 4 WABAs)
CAMPAIGN_SEND_DELAY_MS=250

#--------------------------------------------------------------------
# COMMERCE (P2) — payments are bring-your-own per tenant (set in the app UI,
# Settings → Payments / Store Sync). These flags are for local testing only.
#--------------------------------------------------------------------
# Reuse RAZORPAY_MOCK_MODE for payment links too (simulates the Razorpay API).
RAZORPAY_MOCK_MODE = false
# Set to false ONLY in local dev to skip Shopify/WooCommerce webhook HMAC checks.
ECOMMERCE_VERIFY_SIGNATURE = true

#--------------------------------------------------------------------
# AI REPLIES (P3.1) — platform-level Anthropic key powers the AI reply node
# and the inbox "Suggest" action. Self-hosted owners set their own key.
#--------------------------------------------------------------------
# ANTHROPIC_API_KEY =
# ANTHROPIC_MODEL = claude-3-5-haiku-latest
# Set to true to return a canned reply without calling the API (local/dev/tests).
AI_MOCK_MODE = false

# ── Notifications ────────────────────────────────────────────────────────
# Email (reply alerts, password reset)
# MAIL_HOST = smtp.yourhost.com
# MAIL_PORT = 587
# MAIL_USERNAME =
# MAIL_PASSWORD =
# Web push (browser notifications) — generate with the minishlink/web-push VAPID tool
# VAPID_PUBLIC_KEY =
# VAPID_PRIVATE_KEY =
# VAPID_SUBJECT = mailto:you@yourdomain.com

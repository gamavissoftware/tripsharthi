{
  "expo": {
    "name": "TripSarthi",
    "slug": "tripsarthi",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamavis.tripsarthi",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gamavis.tripsarthi",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "TripSarthi uses the microphone only when you record a voice note to send to a customer."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0a6cc4",
          "defaultChannel": "task",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock TripSarthi with Face ID so your customers' details stay private."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to send to your customers on WhatsApp.",
          "cameraPermission": "Take a photo to send to your customer on WhatsApp.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "TripSarthi reads a contact only when you choose Import from phone, to add that person as a customer."
        }
      ]
    ],
    "scheme": "tripsarthi",
    "extra": {
      "eas": {
        "projectId": "2c64be72-530c-41f8-b620-3ec38b6932c7"
      }
    },
    "owner": "gamavissoftware",
    "runtimeVersion": "2",
    "updates": {
      "url": "https://u.expo.dev/2c64be72-530c-41f8-b620-3ec38b6932c7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
